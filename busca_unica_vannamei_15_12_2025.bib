}

@ARTICLE{Ren201544,
	author = {Ren, Xianyun and Pan, Luqing and Wang, Lin},
	title = {The detoxification process, bioaccumulation and damage effect in juvenile white shrimp Litopenaeus vannamei exposed to chrysene},
	year = {2015},
	journal = {Ecotoxicology and Environmental Safety},
	volume = {114},
