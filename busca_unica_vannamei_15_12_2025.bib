@ARTICLE{Liang2020,
	author = {Liang, Fengyan and Li, Chengpeng and Hou, Tingting and Wen, Chongqing and Kong, Songzhi and Ma, Dong and Sun, Chengbo and Li, Sidong},
	title = {Effects of Chitosan–gentamicin conjugate supplement on non-specific immunity, aquaculture water, intestinal histology and microbiota of pacific white shrimp (litopenaeus vannamei)},
