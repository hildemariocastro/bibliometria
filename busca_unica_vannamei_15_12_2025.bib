	abbrev_source_title = {Aquacult. Rep.},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 23; All Open Access; Gold Open Access; Green Accepted Open Access; Green Open Access}
}

