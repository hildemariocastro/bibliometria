	author = {Sharifinia, Moslem and Afshari Bahmanbeigloo, Zahra and Keshavarzifard, Mehrzad and Khanjani, Mohammad Hossein and Daliri, Moslem and Koochaknejad, E. and Jasour, Mohammad Sedigh},
	title = {Fishmeal replacement by mealworm (Tenebrio molitor) in diet of farmed Pacific white shrimp (Litopenaeus vannamei): effects on growth performance, serum biochemistry, and immune response},
	year = {2023},
	journal = {Aquatic Living Resources},
