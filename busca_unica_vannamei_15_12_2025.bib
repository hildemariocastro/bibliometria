@ARTICLE{Aribah2022,
	author = {Aribah, Dina and Widanarni, Widanarni and Wahyudi, Wahyudi Tri},
	title = {The effectiveness of marine bacterial microcapsules in controlling vibriosis disease caused by the infection of Vibrio parahaemolyticus in white shrimp Litopenaeus vannamei},
	year = {2022},
	journal = {Aquaculture},
	volume = {549},
	pages = {},
