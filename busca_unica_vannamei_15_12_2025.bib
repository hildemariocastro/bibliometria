@ARTICLE{Duan2024,
	author = {Duan, Yafei and Nan, Yuxiu and Xiao, Meng and Yang, Yukai},
	title = {Toxicity of three microcystin variants on the histology, physiological and metabolism of hepatopancreas and intestinal microbiota of Litopenaeus vannamei},
	year = {2024},
	journal = {Comparative Biochemistry and Physiology Part - C: Toxicology and Pharmacology},
	volume = {280},
	pages = {},
	doi = {10.1016/j.cbpc.2024.109904},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85188729100&doi=10.1016%2Fj.cbpc.2024.109904&partnerID=40&md5=9a7eabf28cb15cfe4188357b4ee9a02a},
	affiliations = {Chinese Academy of Fishery Sciences, State Key Laboratory of Mariculture Biobreeding and Sustainable Goods, Beijing, China; Sanya Tropical Fisheries Research Institute, Sanya, Hainan, China; Chinese Academy of Fishery Sciences, Beijing, China},
	abstract = {Microcystins (MCs) are prevalent harmful contaminants within shrimp aquaculture systems, exhibiting a diverse array of variants. Gut microbiota can engage in mutual interactions with the host through the gut-liver axis. In this study, the shrimp Litopenaeus vannamei were subjected to three different variants of MCs (LR, YR, RR) at a concentration of 1 μg/L each, and elucidated the alterations in both intestinal microbiota and hepatopancreas physiological homeostasis. The results showed that all three variants of MCs prompted histological alterations in the hepatopancreas, induced elevated levels of oxidative stress biomarkers (H<inf>2</inf>O<inf>2</inf>, T-SOD, and CAT), disturbed the transcription levels of immune-related genes (Crus, ALF, and Lys), along with an increase in apoptotic genes (Casp-3 and P53). Furthermore, the metabolic profiles of the hepatopancreas were perturbed, particularly in amino acid metabolism such as “lysine degradation” and “β-alanine metabolism”; the mTOR and FoxO signaling were also influenced, encompassing alterations in the transcription levels of related genes. Additionally, the alterations were observed in the intestinal microbiota's diversity and composition, particularly potential beneficial bacteria (Alloprevotella, Bacteroides, Collinsella, Faecalibacterium, and Prevotellaceae UCG-001), which exhibited a positive correlation with the metabolite berberine. These findings reveal that the three MCs variants can impact the health of the shrimp by interfering with the homeostasis of intestinal microbial and hepatopancreas physiology. © 2024 Elsevier Inc.},
	author_keywords = {Intestinal bacteria; Metabolomics; Microcystins; Oxidative stress; Shrimp},
