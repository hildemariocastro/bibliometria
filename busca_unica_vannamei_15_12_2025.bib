}

@ARTICLE{Lin2024,
	author = {Lin, Sihan and Chen, Mengdie and Chen, Xuanqi and Li, Yanmei and Liu, Yafeng and Zhang, Peinan and Hou, Xiangyan and Tan, Beiping and Niu, Jin},
	title = {Supplemental effects of Haematococcus pluvialis in a low-fish meal diet for Litopenaeus vannamei at varying temperatures: growth performance, innate immunity and gut bacterial community},
	year = {2024},
	journal = {Frontiers in Immunology},
