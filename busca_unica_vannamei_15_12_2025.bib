@ARTICLE{Shi2024,
	author = {Shi, Zhaoji and Yao, Fucheng and Liu, Ziqiang and Zhang, Jiaen},
	title = {Microplastics predominantly affect gut microbiota by altering community structure rather than richness and diversity: A meta-analysis of aquatic animals},
	year = {2024},
	journal = {Environmental Pollution},
