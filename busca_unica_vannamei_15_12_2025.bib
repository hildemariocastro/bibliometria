@ARTICLE{Su2023,
	author = {Su, Chen and Li, Jinbao and Pan, Luqing and Zhang, Mengyu and Chen, Zhifei and Lu, Mingxiang},
	title = {Immunotoxicity and the mechanisms of aflatoxin B1-induced growth retardation in shrimp and alleviating effects of bile acids},
	year = {2023},
	journal = {Journal of Hazardous Materials},
	volume = {459},
	pages = {},
	doi = {10.1016/j.jhazmat.2023.132266},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85167800266&doi=10.1016%2Fj.jhazmat.2023.132266&partnerID=40&md5=1b8337d9393f7d77d963285103331ef5},
	affiliations = {Ocean University of China, Qingdao, Shandong, China},
	abstract = {Aflatoxin B1 (AFB1) is one of the most toxic mycotoxins prevalent in the environment and food chain, posing severe health risks to humans and animals. Bile acids are natural detergents synthesized from cholesterol and play a key role in the excretion of toxins in vertebrates. Here, pacific white shrimp (Litopenaeus vannamei) served as an animal model to examine the toxicity mechanisms of AFB1 and assess the potential alleviating effects of bile acids against AFB1. Our results revealed that AFB1 exposure significantly inhibited the growth performance and immune response of shrimp, accompanied by AFB1 accumulation and histological damage. Mechanistically, AFB1-induced DNA damage activated DNA repair mechanisms and induced the arrest of cell cycle via the ATR-cyclin B/cdc2 pathway. Additionally, AFB1 directly suppressed the immune response and growth performance of shrimp by inhibiting Toll and IMD pathways and the secretion of digestive enzymes. Notably, dietary bile acids significantly reduced AFB1 accumulation and alleviated AFB1-induced growth retardation and immunotoxicity in shrimp, and CCKAR, ATR, and Relish may be key mediators of the alleviating effects of bile acids. Our study provided new insights into the toxicity mechanisms of AFB1 in invertebrates and highlighted the potential of bile acids to alleviate AFB1 toxicity. © 2023 Elsevier B.V.},
	author_keywords = {Aflatoxin B1; Bile acids; Immunotoxicity; Shrimp; Transcriptomics},
	keywords = {Aflatoxins; Enzymes; Health risks; Soaps (detergents); Toxicity; Aflatoxin b1; Bile acid; Food chain; Growth performance; Growth-retardation; Immune response; Immunotoxicity; Shrimp; Toxicity mechanisms; Transcriptomics; Immune system; aflatoxin B1; amylase; arachidonic acid; arginine; ATR protein; bile acid; cholecystokinin A receptor; cyclin B; cyclin dependent kinase 1; cycline; DNA; DNA directed DNA polymerase delta; dna polymerase delta subunit 2 like; fatty acid; linoleic acid; malonaldehyde; minichromosome maintenance protein 3; minichromosome maintenance protein 4; minichromosome maintenance protein 5; origin recognition complex; origin recognition complex subunit 3 like; proline; proteinase; purine; pyrimidine; replication factor C; replication factor c subunit 3 like; superoxide dismutase; transcriptome; triacylglycerol lipase; unclassified drug; cell; crustacean; enzyme; immune response; organic acid; secretion; toxicity; toxin; animal experiment; animal model; antibacterial activity; antioxidant activity; arachidonic acid metabolism; Article; base excision repair; basement membrane; blood cell; cell cycle arrest; cell vacuole; controlled study; DNA damage; DNA replication; enzyme activity; fatty acid synthesis; glycolysis; growth retardation; hepatopancreas; histopathology; hydrogen bond; immunotoxicity; k means clustering; KEGG; long term exposure; MAPK signaling; molecular docking; nonhuman; p53 signaling; pancreas secretion; Penaeus vannamei; phagocytosis; Pi3K/Akt signaling; purine metabolism; pyrimidine metabolism; survival rate; transcriptomics; animal; Crustacea; growth disorder; human; sea food; Aflatoxin B1; Animals; Bile Acids and Salts; Growth Disorders; Humans; Seafood},
