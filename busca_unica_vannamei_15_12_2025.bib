@ARTICLE{Avunje2021,
	author = {Avunje, Satheesha and Patil, Prasanna Kumar and Ezaz, Wasim and Praveena, Ezhil and Ray, Arvind Kumar and Baskaran, V. and Alavandi, S. V. and Puthiyedathu, Sandeep Kizhakkekarammal and Vijayan, Koyadan Kizhakedath},
	title = {Effect of oxytetracycline on the biosafety, gut microbial diversity, immune gene expression and withdrawal period in Pacific whiteleg shrimp, Penaeus vannamei},
