}

@ARTICLE{Esteve20001,
	author = {Esteve, Montserrat and Herrera, Francisco C.},
	title = {Hepatopancreatic alterations in Litopenaeus vannamei (boone, 1939) (Crustacea: Decapoda: Penaeidae) experimentally infected with a Vibrio alginolyticus strain},
	year = {2000},
	journal = {Journal of Invertebrate Pathology},
	volume = {76},
