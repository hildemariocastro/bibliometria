	author = {San Andres, Christian F. and Araujo, Adela N. and Nguyen, Khanh Q. and Corby, Trenton L. and Rhodes, Melanie A. and Roy, Luke Aaron and García, Julio C. and Abernathy, Jason W. and Sankappa, Nithin Muliya and Saoud, Imad Patrick and Davis, Donald Allen},
	title = {Effects of Diurnal Oxygen Variation on Survival, Growth, and Stress Gene Expression in Pacific White Shrimp Litopenaeus vannamei},
	year = {2025},
	journal = {Aquaculture Research},
	volume = {2025},
	number = {1},
	pages = {},
	doi = {10.1155/are/8041189},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-105009974084&doi=10.1155%2Fare%2F8041189&partnerID=40&md5=6d0f1f2ac1c1bf85853960f7f8fde226},
	affiliations = {Auburn University, Auburn, AL, United States; USDA ARS Aquatic Animal Health Research Laboratory, Auburn, AL, United States; American University of Beirut, Department of Biology, Beirut, Beirut Governorate, Lebanon},
	abstract = {Oxygen is typically one of the first limiting water quality parameters affecting the culture of aquatic animals. However, there is a limited understanding of the effects of short-term low dissolved oxygen (DO) in Pacific white shrimp reared in outdoor green-water environments exposed to natural diurnal cycles, especially less than 3 mg L<sup>−1</sup> DO, and their impacts in commercial aquaculture settings. The present study evaluated the effects of cyclic short-term low DO conditions in outdoor green water tanks on shrimp survival, growth, nutrient retention, select blood parameters, and gene expression of the gill and hepatopancreas. The experiment was performed in 12 (800 L, 0.8 m<sup>2</sup>) round tanks stocked at 35 shrimp m<sup>−2</sup> (1.99 ± 0.06 g) using three aeration regimens. Four tanks were assigned to each treatment which included: low, medium, and high aeration using 0.25, 0.35, and 0.7 cubic feet per second (cfs) airstones, respectively. Diurnal cycles were allowed to cause varying periodic periods of short-term low DO. We found no difference in shrimp growth, survival, feed utilization, blood parameters, or gene expression of shrimp maintained in systems where DO was maintained near saturation as compared to those experiencing diurnal shifts in DO and nonlethal short-term low DO conditions. Clearly, lethal levels of DO must be avoided but we did not find justification to maintain DO in diurnal systems near saturation throughout the diurnal cycle. © © 2025 Cristhian F. San Andres et al. Aquaculture Research published by John Wiley & Sons Ltd.},
	author_keywords = {aeration; growth; periodic short-term low DO; shrimp},
	keywords = {aeration; dissolved oxygen; diurnal variation; gene expression; growth response; periodicity; saturation; survival},
	correspondence_address = {C.F. San Andres; School of Fisheries Aquaculture and Aquatic Sciences, Auburn University, Auburn, 36849, United States; email: cfs0046@auburn.edu},
	publisher = {John Wiley and Sons Ltd},
	issn = {1355557X},
	coden = {AQREF},
