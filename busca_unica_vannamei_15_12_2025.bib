@ARTICLE{Aranguren2023,
	author = {Aranguren, Fernando L. and Mai, Hungnam and Schofield, Paul J. and R Alenton, Rod Russel},
	title = {A laboratory challenge model for evaluating enyterocytozoon hepatopenaei susceptibility in selected lines of pacific whiteleg shrimp Penaeus vannamei},
	year = {2023},
