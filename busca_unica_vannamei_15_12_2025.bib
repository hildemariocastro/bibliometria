	affiliations = {Ocean University of China, Qingdao, Shandong, China; Ltd., Jinan, Shandong, China},
	abstract = {The potential of bile acids (BAs) to reduce aflatoxin B<inf>1</inf> (AFB<inf>1</inf>) residues and toxicity in Litopenaeus vannamei was evaluated. Both juveniles and subadults were treated with 0, 0.05, 0.15 and 0.25 g/kg BAs for 60 days followed by 10-d AFB<inf>1</inf> exposure (2000 μg/kg), and fifteen shrimp (five shrimp were pooled into one sample, n = 3) from each treatment were collected at five time points (30, 60, 63, 66 and 70 d). All parameters were determined using accepted and standard methods with acceptable accuracy (recovery) of 90–110%. Results demonstrated that BAs reduced the AFB<inf>1</inf> residues in shrimp (limit of detection: 0.01 μg/L, relative standard deviation < 10% and recovery: 92.1–96.8%). BAs increased the detoxification of AFB<inf>1</inf> and decreased the levels of oxidative stress products by increasing Phase II and antioxidant systems, avoiding AFB<inf>1</inf>-induced deterioration of shrimp meat and health risks to human. The confidence level was 95%. © 2021 Elsevier Ltd},
