	author = {Overstreet, Robin M. and Stuck, Kenneth C. and Krol, Rena M. and Hawkins, William E.},
	title = {Experimental Infections with Baculovirus penaei in the White Shrimp Penaeus vannamei (Crustacea: Decapoda) as a Bioassay},
	year = {1988},
	journal = {Journal of the World Aquaculture Society},
	volume = {19},
