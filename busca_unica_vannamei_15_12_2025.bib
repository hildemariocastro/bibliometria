@ARTICLE{Duan2018279,
	author = {Duan, Yafei and Liu, Qingsong and Wang, Yun and Zhang, Jiasong and Xiong, Dalin},
	title = {Impairment of the intestine barrier function in Litopenaeus vannamei exposed to ammonia and nitrite stress},
	year = {2018},
