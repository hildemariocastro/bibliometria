	doi = {10.1016/j.aquaculture.2023.740250},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85174815733&doi=10.1016%2Fj.aquaculture.2023.740250&partnerID=40&md5=a70ee0955b402198c82d72f0ca30130c},
	affiliations = {Ocean University of China, Qingdao, Shandong, China; Hainan Yazhou Bay Seed Laboratory, Sanya, Chin, China},
	abstract = {CpG oligodeoxynucleotides (CpG ODNs) has been considered as a promising immunologic stimulant to improve immunity in poultry and aquaculture when challenged with diseases outbreak and cultivation environment deterioration. In this study, a comprehensive evaluation of CpG ODNs used in white shrimps (Litopenaeus vannamei) was conducted. Eight tandem CpG ODNs were added to the basic diet with a concentration of 50 mg kg<sup>−1</sup> to investigate their effects on antioxidant capacity, immunological parameters, and intestinal microbiota in white shrimp, when the conventional immunologic stimulants (vitamin C and β-glucan) were set as control. After two weeks, the results indicated that shrimps fed with tandem CpG ODNs (consisting of CpG 2216, 2006, 8954, 1826, and M362) exhibited the highest expression level (3.68–7.92-fold change, p < 0.05) of IL-8, TOR and proPO in hepatopancreas and intestine, better enhancement of antioxidant enzymes activity (GST with 4 times and LZM with 6.78 times than control, p < 0.05), and the relative abundance of pathogenic bacteria like Vibrio reduced. The observation of intestinal and hepatopancreas histologic sections showed that the dietary immune stimulant did not cause structural changes to the vital organs of shrimps. Therefore, the results demonstrated that dietary with tandem CpG ODNs can significantly enhance the antioxidant capacity, gut microbiota, and innate immunity of shrimps. © 2023 Elsevier B.V.},
	author_keywords = {Antioxidant capacity; CpG oligodeoxynucleotides; Innate immunity; Intestinal microbiota; Litopenaeus vannamei},
