@ARTICLE{Li2023,
	author = {Li, Yiming and Yang, Ying and Li, Siwen and Ye, Yucong and Du, Xinglin and Liu, Xingguo and Jiang, Qichen and Che, Xuan},
	title = {Effects of dietary melatonin on antioxidant and immune function of the Pacific white shrimp (Litopenaeus vannamei), as determined by transcriptomic analysis},
	year = {2023},
	journal = {Comparative Biochemistry and Physiology - Part D: Genomics and Proteomics},
