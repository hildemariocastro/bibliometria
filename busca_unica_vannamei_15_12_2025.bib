@ARTICLE{Maftuch2017249,
	author = {Maftuch, null and Aziz, Khadijah and Eslfitri, Deaniza and Sanoesi, Ellana and Prihanto, Asep Awaludin},
	title = {Enrofloxacin stimulates cell death in several tissues of vannamei shrimp (Litopenaeus vannamei)},
