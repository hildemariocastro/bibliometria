	title = {Probiotic, Lactobacillus pentosus BD6 boost the growth and health status of white shrimp, Litopenaeus vannamei via oral administration},
	year = {2021},
	journal = {Fish and Shellfish Immunology},
	volume = {117},
	pages = {124 - 135},
	doi = {10.1016/j.fsi.2021.07.024},
